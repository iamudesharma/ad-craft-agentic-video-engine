# Copy to .env and fill in real values. NEVER commit the real .env.
# LLM (OpenAI-compatible: Groq, Together, OpenAI, local vLLM, ...)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.7

# Set to true to run the pipeline with deterministic canned output (no API key needed)
FAKE_LLM=false

# PocketBase (local server in backend/pocketbase/)
PB_URL=http://127.0.0.1:8090
PB_ADMIN_EMAIL=admin@localhost.dev
PB_ADMIN_PASSWORD=local-dev-admin-123
JOB_TIMEOUT_MINUTES=30

# Media
MEDIA_ROOT=media

# Voiceover
TTS_VOICE=en-US-ChristopherNeural
TTS_FALLBACK_SILENT=true

# Images
IMAGE_WIDTH=1080
IMAGE_HEIGHT=1920
IMAGE_FALLBACK_PLACEHOLDER=true
MAX_SCENES=8

# Image generation provider: cloudflare | pollinations
# Cloudflare Workers AI (FLUX.1 Schnell) — free 10,000 Neurons/day.
# Get Account ID + API token: dashboard -> Workers AI -> Use REST API.
IMAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# flux-2-klein-4b = cheap + fast (~63 Neurons per 9:16 image, ~159 free/day)
CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
CLOUDFLARE_IMAGE_STEPS=4
CLOUDFLARE_IMAGE_MAX_SIDE=1024
CLOUDFLARE_MIN_INTERVAL_SECONDS=30

# Workflow
HITL_REQUIRED=true
FPS=25
FONT_PATH=/System/Library/Fonts/Helvetica.ttc

# Server
CORS_ORIGINS=["*"]
