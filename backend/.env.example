# Copy to .env and fill in real values. NEVER commit the real .env.
# LLM (OpenAI-compatible: Groq, Together, OpenAI, local vLLM, ...)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.7

# Set to true to run the pipeline with deterministic canned output (no API key needed)
FAKE_LLM=false

# PocketBase (local server in backend/pocketbase/)
PB_URL=http://127.0.0.1:8090
PB_ADMIN_EMAIL=admin@localhost.dev
PB_ADMIN_PASSWORD=local-dev-admin-123
JOB_TIMEOUT_MINUTES=30

# Media
MEDIA_ROOT=media

# Voiceover
TTS_VOICE=en-US-ChristopherNeural
TTS_FALLBACK_SILENT=true

# Images
IMAGE_WIDTH=1080
IMAGE_HEIGHT=1920
IMAGE_FALLBACK_PLACEHOLDER=true
MAX_SCENES=8

# Workflow
HITL_REQUIRED=true
FPS=25
FONT_PATH=/System/Library/Fonts/Helvetica.ttc

# Server
CORS_ORIGINS=["*"]
